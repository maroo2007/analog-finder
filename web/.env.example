# Copy this file to web/.env for local development (web/.env is gitignored).
# Never commit a real key. In production, set these in the Netlify UI:
# Site configuration > Environment variables.

# Google AI Studio key for "Ask the analyst" (free tier). Server-side only.
GEMINI_API_KEY=

# Optional: override the model (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: daily limits (defaults 25 per visitor, 400 in total).
# ANALYST_PER_VISITOR_PER_DAY=25
# ANALYST_TOTAL_PER_DAY=400

# Optional, public, browser-side: an ArcGIS key restricted to your site's
# address, to enable Esri World Imagery as the satellite fallback.
# VITE_ESRI_API_KEY=
