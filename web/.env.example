# Copy this file to web/.env for local development (web/.env is gitignored).
# Never commit a real key. In production, set these in the Netlify UI:
# Site configuration > Environment variables.

# Google AI Studio key for "Ask the analyst" (free tier). Server-side only.
GEMINI_API_KEY=

# Optional: override the model (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: daily limits, reset at midnight Pacific time (when Google resets
# the free quota). Defaults: 25 questions per visitor per day, and 100 Gemini
# requests per day for the whole site (a question uses one request, or two
# when the analyst also selects a site or twin: 50 to 100 questions).
# Reaching either shows a friendly "back tomorrow" note, never an error.
# Keep the total at half the project's free daily request quota or less:
# https://aistudio.google.com/rate-limit
# ANALYST_PER_VISITOR_PER_DAY=25
# ANALYST_TOTAL_PER_DAY=100

# Optional, public, browser-side: an ArcGIS key restricted to your site's
# address, to enable Esri World Imagery as the satellite fallback.
# VITE_ESRI_API_KEY=
